#:import dp kivy.metrics.dp

# ---------- Строка списка операций ----------
<TransactionRow>:
    orientation: 'horizontal'
    padding: dp(10)
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.category
        size_hint_x: 0.3
    Label:
        text: root.description
        size_hint_x: 0.4
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
    Label:
        text: ('+' if root.kind == 'income' else '-') + ('%.2f руб.' % root.amount)
        size_hint_x: 0.3
        color: (0.3, 0.9, 0.4, 1) if root.kind == 'income' else (1, 0.4, 0.4, 1)

# ---------- Список операций (RecycleView) ----------
<TransactionsRV>:
    viewclass: 'TransactionRow'
    RecycleBoxLayout:
        default_size: None, dp(60)
        default_size_hint: 1, None
        size_hint_y: None
        height: self.minimum_height
        orientation: 'vertical'
        spacing: dp(2)

# ---------- Главный экран ----------
<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(8)

        Label:
            text: 'БИЗНЕС-ТРЕКЕР ДОХОДОВ И РАСХОДОВ'
            font_size: '20sp'
            bold: True
            color: 0.2, 0.4, 0.8, 1
            size_hint_y: None
            height: dp(40)

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)
            Button:
                text: 'Добавить'
                on_press: root.show_add_popup()
                background_color: 0.2, 0.6, 0.2, 1
            Button:
                text: 'Аналитика'
                on_press: root.show_analytics()
                background_color: 0.3, 0.3, 0.7, 1
            Button:
                text: 'Графики'
                on_press: root.show_charts()
                background_color: 0.5, 0.3, 0.7, 1

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)
            Button:
                text: 'Синхронизация'
                on_press: root.sync_with_cloud()
                background_color: 0.2, 0.5, 0.7, 1
            Button:
                text: 'Экспорт CSV'
                on_press: root.export_data()
                background_color: 0.7, 0.5, 0.2, 1

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            Label:
                text: 'Доходы: %.2f' % root.total_income
                color: 0.3, 0.9, 0.4, 1
                bold: True
            Label:
                text: 'Расходы: %.2f' % root.total_expenses
                color: 1, 0.4, 0.4, 1
                bold: True
            Label:
                text: 'Баланс: %.2f' % root.balance
                color: (0.3, 0.9, 0.4, 1) if root.balance >= 0 else (1, 0.4, 0.4, 1)
                bold: True

        Label:
            text: root.status_text
            font_size: '13sp'
            color: 0.7, 0.7, 0.7, 1
            size_hint_y: None
            height: dp(24)

        TransactionsRV:
            id: rv

# ---------- Окно добавления операции ----------
<AddTransactionPopup>:
    size_hint: 0.85, 0.8
    title: 'Новая операция'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(8)

        Label:
            text: 'Тип:'
            size_hint_y: None
            height: dp(24)
        Spinner:
            id: kind_spinner
            text: 'Расход'
            values: ['Расход', 'Доход']
            size_hint_y: None
            height: dp(44)
            on_text: root.update_categories(self.text)

        Label:
            text: 'Категория:'
            size_hint_y: None
            height: dp(24)
        Spinner:
            id: category_spinner
            text: 'Выберите категорию'
            size_hint_y: None
            height: dp(44)

        Label:
            text: 'Описание:'
            size_hint_y: None
            height: dp(24)
        TextInput:
            id: description_input
            multiline: False
            size_hint_y: None
            height: dp(44)

        Label:
            text: 'Сумма (руб.):'
            size_hint_y: None
            height: dp(24)
        TextInput:
            id: amount_input
            multiline: False
            input_filter: 'float'
            size_hint_y: None
            height: dp(44)

        BoxLayout:
            spacing: dp(10)
            Button:
                text: 'Отмена'
                on_press: root.dismiss()
                background_color: 0.8, 0.2, 0.2, 1
            Button:
                text: 'Сохранить'
                on_press: root.save_transaction()
                background_color: 0.2, 0.6, 0.2, 1

# ---------- Экран с графиками ----------
<ChartsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(8)

        ChartBox:
            id: chart

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)
            Button:
                text: 'Обновить'
                on_press: root.update_chart()
            Button:
                text: 'Назад'
                on_press: root.go_back()
